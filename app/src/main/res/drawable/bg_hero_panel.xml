<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#293443" android:centerColor="#111923" android:endColor="#080C13"/>
            <corners android:radius="28dp"/>
            <stroke android:width="1.5dp" android:color="#C5A34D"/>
        </shape>
    </item>
    <item android:inset="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp"/>
            <stroke android:width="1dp" android:color="#33FFFFFF"/>
            <solid android:color="#00000000"/>
        </shape>
    </item>
    <item android:gravity="top" android:height="2dp" android:left="36dp" android:right="36dp">
        <shape android:shape="rectangle">
            <solid android:color="#E4C56C"/>
        </shape>
    </item>
</layer-list>