<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="230dp" android:centerX="50%" android:centerY="48%" android:startColor="#55E6C66D" android:centerColor="#1D8B713A" android:endColor="#008B713A"/>
        </shape>
    </item>
    <item android:inset="12dp">
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="#66D6B45A"/>
            <solid android:color="#00000000"/>
        </shape>
    </item>
    <item android:inset="34dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#33FFFFFF"/>
            <solid android:color="#00000000"/>
        </shape>
    </item>
    <item android:inset="58dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#22D6B45A"/>
            <solid android:color="#00000000"/>
        </shape>
    </item>
</layer-list>