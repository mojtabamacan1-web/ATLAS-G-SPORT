<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFE69A" android:centerColor="#D7B24D" android:endColor="#98701D"/>
            <corners android:radius="18dp"/>
            <stroke android:width="1.5dp" android:color="#FFF0B8"/>
        </shape>
    </item>
    <item android:inset="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="#66FFFFFF"/>
            <solid android:color="#00000000"/>
        </shape>
    </item>
</layer-list>