<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#343B49" android:centerColor="#171D27" android:endColor="#0B1018"/>
            <corners android:radius="24dp"/>
            <stroke android:width="1.2dp" android:color="#A88C4E"/>
        </shape>
    </item>
    <item android:inset="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp"/>
            <stroke android:width="1dp" android:color="#22FFFFFF"/>
            <solid android:color="#00000000"/>
        </shape>
    </item>
</layer-list>