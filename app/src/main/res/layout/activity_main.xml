
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/luxury_black"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12:45"
        android:textColor="@color/luxury_cream"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SATURDAY"
        android:textColor="@color/luxury_gray"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tvClock"
        app:layout_constraintTop_toBottomOf="@id/tvClock" />

    <TextView
        android:id="@+id/tvGpsStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GPS • READY"
        android:textColor="@color/luxury_gold"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/speedCard"
        android:layout_width="145dp"
        android:layout_height="190dp"
        android:background="@drawable/bg_luxury_card"
        android:padding="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.48">

        <TextView
            android:id="@+id/speedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SPEED"
            android:textColor="@color/luxury_gold"
            android:textSize="13sp"
            android:letterSpacing="0.15"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/luxury_cream"
            android:textSize="58sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/speedUnit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/speedTitle"
            app:layout_constraintVertical_bias="0.6" />

        <TextView
            android:id="@+id/speedUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KM / H"
            android:textColor="@color/luxury_gray"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/carTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ATLAS G"
        android:textColor="@color/luxury_gold"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.25"
        app:layout_constraintBottom_toTopOf="@id/carImage"
        app:layout_constraintEnd_toEndOf="@id/carImage"
        app:layout_constraintStart_toStartOf="@id/carImage" />

    <ImageView
        android:id="@+id/carGlow"
        android:layout_width="300dp"
        android:layout_height="180dp"
        android:contentDescription="Car ambient glow"
        android:src="@drawable/bg_glow"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@id/carImage"
        app:layout_constraintEnd_toEndOf="@id/carImage"
        app:layout_constraintStart_toStartOf="@id/carImage"
        app:layout_constraintTop_toTopOf="@id/carImage" />

    <ImageView
        android:id="@+id/carImage"
        android:layout_width="0dp"
        android:layout_height="230dp"
        android:contentDescription="Saipa Atlas G"
        android:src="@drawable/atlas_car"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/mediaCard"
        app:layout_constraintStart_toEndOf="@id/speedCard"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.48" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mediaCard"
        android:layout_width="175dp"
        android:layout_height="190dp"
        android:background="@drawable/bg_luxury_card"
        android:padding="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.48">

        <TextView
            android:id="@+id/mediaTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOW PLAYING"
            android:textColor="@color/luxury_gold"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSongName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="No music playing"
            android:textColor="@color/luxury_cream"
            android:textSize="14sp"
            android:maxLines="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mediaTitle" />

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="42dp"
            android:layout_height="45dp"
            android:backgroundTint="@color/luxury_card_stroke"
            android:text="|◀"
            android:textColor="@color/luxury_cream"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="48dp"
            android:layout_height="45dp"
            android:backgroundTint="@color/luxury_gold_dark"
            android:text="▶"
            android:textColor="@color/luxury_cream"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnNext"
            app:layout_constraintStart_toEndOf="@id/btnPrev" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="42dp"
            android:layout_height="45dp"
            android:backgroundTint="@color/luxury_card_stroke"
            android:text="▶|"
            android:textColor="@color/luxury_cream"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tireTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TIRE PRESSURE"
        android:textColor="@color/luxury_gold"
        android:textSize="11sp"
        android:letterSpacing="0.12"
        app:layout_constraintBottom_toTopOf="@id/tireValues"
        app:layout_constraintEnd_toEndOf="@id/tireValues"
        app:layout_constraintStart_toStartOf="@id/tireValues" />

    <TextView
        android:id="@+id/tireValues"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="FL  32     FR  32\nRL  32     RR  32"
        android:textColor="@color/luxury_cream"
        android:textSize="12sp"
        android:lineSpacingExtra="5dp"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/btnMap"
        app:layout_constraintEnd_toStartOf="@id/btnSettings"
        app:layout_constraintStart_toStartOf="@id/btnMap" />

    <Button
        android:id="@+id/btnMap"
        android:layout_width="110dp"
        android:layout_height="48dp"
        android:backgroundTint="@color/luxury_card_stroke"
        android:text="MAP"
        android:textColor="@color/luxury_cream"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="110dp"
        android:layout_height="48dp"
        android:backgroundTint="@color/luxury_gold_dark"
        android:text="SETTINGS"
        android:textColor="@color/luxury_cream"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
