<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/luxury_black"
    android:padding="6dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gTop" android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.105" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gBottom" android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.785" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gLeft" android:orientation="vertical"
        app:layout_constraintGuide_percent="0.178" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gRight" android:orientation="vertical"
        app:layout_constraintGuide_percent="0.822" />

    <!-- Header inspired by the supplied reference -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp" android:layout_height="0dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        android:background="@drawable/bg_luxury_card"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/gTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="◆" android:textColor="@color/luxury_gold" android:textSize="25sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="14dp"
            android:text="ATLAS G  SPORT" android:textStyle="bold|italic"
            android:textColor="@color/luxury_cream" android:textSize="20sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="SAIPA  •  GPS  •  Wi-Fi  •  BT"
            android:textColor="@color/luxury_cream" android:textSize="12sp" />
        <TextView android:id="@+id/tvDate" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="12dp"
            android:text="1405/08/24" android:textColor="@color/luxury_gray" android:textSize="11sp" />
        <TextView android:id="@+id/tvClock" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:text="20:45" android:textColor="@color/luxury_cream"
            android:textStyle="bold" android:textSize="25sp" />
    </LinearLayout>

    <!-- Weather side panel -->
    <LinearLayout
        android:id="@+id/weatherPanel"
        android:layout_width="0dp" android:layout_height="0dp"
        android:layout_margin="5dp" android:padding="8dp"
        android:gravity="center" android:orientation="vertical"
        android:background="@drawable/bg_luxury_card"
        app:layout_constraintTop_toTopOf="@id/gTop"
        app:layout_constraintBottom_toTopOf="@id/gBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/gLeft">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="☀️" android:textSize="42sp" />
        <TextView android:id="@+id/tvWeatherTemp" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="--°C"
            android:textColor="@color/luxury_white" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvWeatherCity" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="یزد  📍"
            android:textColor="@color/luxury_cream" android:textSize="16sp" />
        <TextView android:id="@+id/tvWeatherCondition" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="نیمه ابری"
            android:textColor="@color/luxury_gray" android:textSize="13sp" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="10dp" android:layout_marginBottom="8dp"
            android:background="@color/luxury_gold_dark" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="H: 24°     L: 12°" android:textColor="@color/luxury_cream" android:textSize="12sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="☀️   ☾   ☀️"
            android:textColor="@color/luxury_gold" android:textSize="19sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="امروز     فردا     پس‌فردا" android:textColor="@color/luxury_cream" android:textSize="10sp" />
    </LinearLayout>

    <!-- Main Atlas showcase -->
    <FrameLayout
        android:id="@+id/centerPanel"
        android:layout_width="0dp" android:layout_height="0dp"
        android:layout_margin="5dp" android:background="@drawable/bg_luxury_card"
        app:layout_constraintTop_toTopOf="@id/gTop"
        app:layout_constraintBottom_toTopOf="@id/gBottom"
        app:layout_constraintStart_toEndOf="@id/gLeft"
        app:layout_constraintEnd_toStartOf="@id/gRight">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal" android:layout_marginTop="8dp"
            android:text="SAIPA" android:textColor="@color/luxury_cream"
            android:textStyle="italic|bold" android:textSize="15sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal" android:layout_marginTop="27dp"
            android:text="ATLAS G  SPORT" android:textColor="@color/luxury_gold"
            android:textStyle="bold|italic" android:textSize="23sp" />
        <ImageView android:id="@+id/imgAtlas" android:layout_width="match_parent"
            android:layout_height="match_parent" android:layout_gravity="center"
            android:padding="12dp" android:scaleType="fitCenter"
            android:src="@drawable/atlas_car" android:contentDescription="Saipa Atlas G" />
    </FrameLayout>

    <!-- Tire pressure panel: values remain placeholders until vehicle data is available -->
    <LinearLayout
        android:id="@+id/tirePanel"
        android:layout_width="0dp" android:layout_height="0dp"
        android:layout_margin="5dp" android:padding="8dp"
        android:gravity="center" android:orientation="vertical"
        android:background="@drawable/bg_luxury_card"
        app:layout_constraintTop_toTopOf="@id/gTop"
        app:layout_constraintBottom_toTopOf="@id/gBottom"
        app:layout_constraintStart_toEndOf="@id/gRight"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="♧" android:textColor="@color/luxury_gold" android:textSize="36sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="فشار باد تایرها" android:textColor="@color/luxury_cream"
            android:textStyle="bold" android:textSize="14sp" />
        <TextView android:id="@+id/tvFrontTires" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:gravity="center" android:text="جلو\n--   |   --"
            android:textColor="@color/luxury_white" android:textSize="14sp" />
        <TextView android:id="@+id/tvRearTires" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:gravity="center" android:text="عقب\n--   |   --"
            android:textColor="@color/luxury_white" android:textSize="14sp" />
        <TextView android:id="@+id/tvTpmsStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:text="وضعیت: نامشخص" android:textColor="@color/luxury_gold" android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom dock -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp" android:layout_height="0dp"
        android:orientation="horizontal" android:gravity="center"
        android:padding="5dp" android:background="@drawable/bg_luxury_card"
        app:layout_constraintTop_toTopOf="@id/gBottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/tvSpeed" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1.1"
            android:gravity="center" android:text="◉\n0 km/h"
            android:textColor="@color/luxury_gold" android:textStyle="bold" android:textSize="19sp" />
        <Button android:id="@+id/btnMap" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="3dp" android:minWidth="0dp"
            android:text="⌖\nنقشه" android:textAllCaps="false"
            android:backgroundTint="@color/luxury_card_bg"
            android:textColor="@color/luxury_cream" android:textSize="15sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1.5" android:orientation="vertical"
            android:gravity="center" android:background="@drawable/bg_luxury_card">
            <TextView android:id="@+id/tvSongName" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:maxLines="1" android:ellipsize="end" android:text="موسیقی در حال پخش نیست"
                android:textColor="@color/luxury_cream" android:textSize="12sp" />
            <TextView android:id="@+id/tvArtist" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:maxLines="1" android:text="موزیک پلیر"
                android:textColor="@color/luxury_gray" android:textSize="10sp" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center">
                <Button android:id="@+id/btnPrev" android:layout_width="42dp"
                    android:layout_height="38dp" android:minWidth="0dp" android:text="|◀"
                    android:backgroundTint="@color/luxury_card_bg" android:textColor="@color/luxury_gold" />
                <Button android:id="@+id/btnPlay" android:layout_width="48dp"
                    android:layout_height="38dp" android:minWidth="0dp" android:text="▶"
                    android:backgroundTint="@color/luxury_gold_dark" android:textColor="@color/luxury_black" />
                <Button android:id="@+id/btnNext" android:layout_width="42dp"
                    android:layout_height="38dp" android:minWidth="0dp" android:text="▶|"
                    android:backgroundTint="@color/luxury_card_bg" android:textColor="@color/luxury_gold" />
            </LinearLayout>
        </LinearLayout>
        <Button android:id="@+id/btnApps" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="3dp" android:minWidth="0dp" android:text="▦\nبرنامه‌ها"
            android:textAllCaps="false" android:backgroundTint="@color/luxury_card_bg"
            android:textColor="@color/luxury_cream" android:textSize="14sp" />
        <Button android:id="@+id/btnSettings" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="3dp" android:minWidth="0dp" android:text="⚙\nتنظیمات"
            android:textAllCaps="false" android:backgroundTint="@color/luxury_card_bg"
            android:textColor="@color/luxury_cream" android:textSize="14sp" />
        <Button android:id="@+id/btnAbout" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="3dp" android:minWidth="0dp" android:text="ⓘ\nدرباره ما"
            android:textAllCaps="false" android:backgroundTint="@color/luxury_card_bg"
            android:textColor="@color/luxury_cream" android:textSize="14sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>