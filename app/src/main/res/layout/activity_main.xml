<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/luxury_black"
    android:padding="6dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.105" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.805" />

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guidelineHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⌂   ATLAS G  SPORT"
            android:textColor="@color/luxury_gold"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="● GPS    ◉ Wi-Fi    ᛒ BT"
            android:textColor="@color/luxury_cream"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="1405/08/16"
            android:textColor="@color/luxury_gray"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20:45"
            android:textColor="@color/luxury_cream"
            android:textSize="23sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/weatherPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_luxury_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp"
        app:layout_constraintWidth_percent="0.17"
        app:layout_constraintTop_toTopOf="@id/guidelineHeader"
        app:layout_constraintBottom_toTopOf="@id/guidelineBottom"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="آب‌وهوا"
            android:textColor="@color/luxury_gold"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="☀"
            android:textColor="@color/luxury_gold"
            android:textSize="34sp" />
        <TextView
            android:id="@+id/tvWeatherTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--°C"
            android:textColor="@color/luxury_cream"
            android:textSize="25sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvWeatherCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="یزد"
            android:textColor="@color/luxury_cream"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/tvWeatherCondition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="نیمه ابری"
            android:textColor="@color/luxury_gray"
            android:textSize="11sp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/luxury_gold_dark" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="امروز   فردا   پس‌فردا"
            android:textColor="@color/luxury_cream"
            android:textSize="9sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/centerPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:background="@drawable/bg_luxury_card"
        app:layout_constraintWidth_percent="0.62"
        app:layout_constraintTop_toTopOf="@id/guidelineHeader"
        app:layout_constraintBottom_toTopOf="@id/guidelineBottom"
        app:layout_constraintStart_toEndOf="@id/weatherPanel"
        app:layout_constraintEnd_toStartOf="@id/tirePanel">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:text="SAIPA  ATLAS G  SPORT"
            android:textColor="@color/luxury_gold"
            android:textSize="16sp"
            android:textStyle="bold|italic" />

        <ImageView
            android:id="@+id/imgAtlas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/atlas_car"
            android:contentDescription="Saipa Atlas G" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/tirePanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_luxury_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp"
        app:layout_constraintWidth_percent="0.17"
        app:layout_constraintTop_toTopOf="@id/guidelineHeader"
        app:layout_constraintBottom_toTopOf="@id/guidelineBottom"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="فشار باد تایرها"
            android:textColor="@color/luxury_gold"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvFrontTires"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="جلو\n--  |  --"
            android:textColor="@color/luxury_cream"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvRearTires"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="عقب\n--  |  --"
            android:textColor="@color/luxury_cream"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvTpmsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="● وضعیت نامشخص"
            android:textColor="@color/luxury_gold"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_luxury_card"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="5dp"
        app:layout_constraintTop_toTopOf="@id/guidelineBottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05"
            android:gravity="center"
            android:text="◉  0\nkm/h"
            android:textColor="@color/luxury_gold"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:backgroundTint="@color/luxury_card_bg"
            android:minWidth="0dp"
            android:text="⌖\nنقشه"
            android:textColor="@color/luxury_cream"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1.35"
            android:background="@drawable/bg_luxury_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">

            <TextView
                android:id="@+id/tvSongName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="موسیقی در حال پخش"
                android:textColor="@color/luxury_cream"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="♪ موسیقی"
                android:textColor="@color/luxury_gray"
                android:textSize="9sp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnPrev"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:backgroundTint="@color/luxury_card_bg"
                    android:minWidth="0dp"
                    android:text="|◀"
                    android:textColor="@color/luxury_gold"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnPlay"
                    android:layout_width="42dp"
                    android:layout_height="38dp"
                    android:backgroundTint="@color/luxury_gold_dark"
                    android:minWidth="0dp"
                    android:text="▶"
                    android:textColor="@color/luxury_black"
                    android:textSize="14sp" />
                <Button
                    android:id="@+id/btnNext"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:backgroundTint="@color/luxury_card_bg"
                    android:minWidth="0dp"
                    android:text="▶|"
                    android:textColor="@color/luxury_gold"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnApps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:backgroundTint="@color/luxury_card_bg"
            android:minWidth="0dp"
            android:text="▦\nبرنامه‌ها"
            android:textColor="@color/luxury_cream"
            android:textSize="12sp" />
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:backgroundTint="@color/luxury_card_bg"
            android:minWidth="0dp"
            android:text="⚙\nتنظیمات"
            android:textColor="@color/luxury_cream"
            android:textSize="12sp" />
        <Button
            android:id="@+id/btnAbout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:backgroundTint="@color/luxury_card_bg"
            android:minWidth="0dp"
            android:text="ⓘ\nدرباره ما"
            android:textColor="@color/luxury_cream"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
