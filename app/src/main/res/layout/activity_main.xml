
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:padding="10dp">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#100D09"
        android:paddingHorizontal="18dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌂"
            android:textColor="#E8C987"
            android:textSize="30sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="22dp"
            android:text="ATLAS G SPORT"
            android:textColor="#E8C987"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS  •  Wi-Fi  •  BT"
            android:textColor="#F5F0DC"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tvClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="20:45"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- WEATHER PANEL -->
    <LinearLayout
        android:id="@+id/weatherPanel"
        android:layout_width="190dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_luxury_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomBar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀"
            android:textColor="#E8C987"
            android:textSize="54sp"/>

        <TextView
            android:id="@+id/tvWeatherTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18°C"
            android:textColor="#FFFFFF"
            android:textSize="42sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvWeatherCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="یزد"
            android:textColor="#F5F0DC"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/tvWeatherCondition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="نیمه ابری"
            android:textColor="#AAAAAA"
            android:textSize="14sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#66563A"
            android:layout_marginVertical="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="H: 24°     L: 12°"
            android:textColor="#F5F0DC"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TODAY"
            android:textColor="#D4AF37"
            android:textSize="12sp"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

    <!-- CENTER CAR DISPLAY -->
    <LinearLayout
        android:id="@+id/centerPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#090807"
        app:layout_constraintStart_toEndOf="@id/weatherPanel"
        app:layout_constraintEnd_toStartOf="@id/tirePanel"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomBar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAIPA"
            android:textColor="#F5F0DC"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ATLAS G SPORT"
            android:textColor="#E8C987"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>

        <ImageView
            android:id="@+id/imgAtlas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:src="@drawable/atlas_car"
            android:scaleType="fitCenter"
            android:contentDescription="Saipa Atlas G"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ATLAS G SPORT  •  DRIVE IN STYLE"
            android:textColor="#D4AF37"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"/>

    </LinearLayout>

    <!-- TIRE PRESSURE PANEL -->
    <LinearLayout
        android:id="@+id/tirePanel"
        android:layout_width="190dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_luxury_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomBar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♧"
            android:textColor="#E8B51C"
            android:textSize="42sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="فشار باد تایرها"
            android:textColor="#F5F0DC"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#66563A"
            android:layout_marginVertical="12dp"/>

        <TextView
            android:id="@+id/tvFrontTires"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2.3 Bar    2.3 Bar"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="      🚘"
            android:textColor="#E8C987"
            android:textSize="44sp"
            android:layout_marginVertical="12dp"/>

        <TextView
            android:id="@+id/tvRearTires"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2.4 Bar    2.4 Bar"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvTpmsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓  وضعیت نامشخص"
            android:textColor="#D4AF37"
            android:textSize="15sp"
            android:layout_marginTop="22dp"/>

    </LinearLayout>

    <!-- BOTTOM BAR -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="#100D09"
        android:padding="5dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◉"
                android:textColor="#E8C987"
                android:textSize="35sp"/>

            <TextView
                android:id="@+id/tvSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 km/h"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⌖\nنقشه"
            android:textColor="#F5F0DC"
            android:textSize="16sp"
            android:backgroundTint="#292016"/>

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="♫\nموسیقی"
            android:textColor="#F5F0DC"
            android:textSize="16sp"
            android:backgroundTint="#292016"/>

        <Button
            android:id="@+id/btnApps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="▦\nبرنامه‌ها"
            android:textColor="#F5F0DC"
            android:textSize="16sp"
            android:backgroundTint="#292016"/>

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⚙\nتنظیمات"
            android:textColor="#F5F0DC"
            android:textSize="16sp"
            android:backgroundTint="#292016"/>

        <Button
            android:id="@+id/btnAbout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="ⓘ\nدرباره ما"
            android:textColor="#F5F0DC"
            android:textSize="15sp"
            android:backgroundTint="#292016"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
