
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/luxury_black"
    android:padding="20dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="@color/luxury_cream"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-light"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="..."
        android:textColor="@color/luxury_gold"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@id/tvClock"
        app:layout_constraintTop_toTopOf="@id/tvClock"
        app:layout_constraintBottom_toBottomOf="@id/tvClock"/>

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ATLAS G SPORT"
        android:textColor="@color/luxury_gold"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Left Speed Panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardSpeed"
        android:layout_width="170dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_luxury_card"
        android:padding="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvClock"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:id="@+id/speedRing"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_gold_ring"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/luxury_cream"
            android:textSize="38sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/speedRing"
            app:layout_constraintBottom_toBottomOf="@id/speedRing"
            app:layout_constraintStart_toStartOf="@id/speedRing"
            app:layout_constraintEnd_toEndOf="@id/speedRing"/>

        <TextView
            android:id="@+id/tvSpeedUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KM/H"
            android:textColor="@color/luxury_gold"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/speedRing"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvGpsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS: در حال اتصال..."
            android:textColor="@color/luxury_gray"
            android:textSize="10sp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvSpeedUnit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Center Car Glow -->
    <View
        android:id="@+id/carGlow"
        android:layout_width="300dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_glow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Atlas G Image -->
    <ImageView
        android:id="@+id/imgCar"
        android:layout_width="340dp"
        android:layout_height="190dp"
        android:src="@drawable/atlas_car"
        android:scaleType="fitCenter"
        android:contentDescription="Saipa Atlas G"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Tire Pressure Indicators - Demo Only -->
    <TextView
        android:id="@+id/tvTireFL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_luxury_card"
        android:padding="7dp"
        android:text="FL: 32 PSI"
        android:textColor="@color/luxury_cream"
        android:textSize="10sp"
        app:layout_constraintBottom_toTopOf="@id/imgCar"
        app:layout_constraintEnd_toStartOf="@id/imgCar"
        android:layout_marginEnd="-20dp"
        android:layout_marginBottom="-10dp"/>

    <TextView
        android:id="@+id/tvTireFR"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_luxury_card"
        android:padding="7dp"
        android:text="FR: 32 PSI"
        android:textColor="@color/luxury_cream"
        android:textSize="10sp"
        app:layout_constraintBottom_toTopOf="@id/imgCar"
        app:layout_constraintStart_toEndOf="@id/imgCar"
        android:layout_marginStart="-20dp"
        android:layout_marginBottom="-10dp"/>

    <TextView
        android:id="@+id/tvTireRL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_luxury_card"
        android:padding="7dp"
        android:text="RL: 31 PSI"
        android:textColor="@color/luxury_cream"
        android:textSize="10sp"
        app:layout_constraintTop_toBottomOf="@id/imgCar"
        app:layout_constraintEnd_toStartOf="@id/imgCar"
        android:layout_marginEnd="-20dp"
        android:layout_marginTop="-10dp"/>

    <TextView
        android:id="@+id/tvTireRR"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_luxury_card"
        android:padding="7dp"
        android:text="RR: 31 PSI"
        android:textColor="@color/luxury_cream"
        android:textSize="10sp"
        app:layout_constraintTop_toBottomOf="@id/imgCar"
        app:layout_constraintStart_toEndOf="@id/imgCar"
        android:layout_marginStart="-20dp"
        android:layout_marginTop="-10dp"/>

    <!-- Right Media Panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardRight"
        android:layout_width="190dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_luxury_card"
        android:padding="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvClock"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvMediaTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="مدیا پلیر"
            android:textColor="@color/luxury_gold"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvSongName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="آماده پخش"
            android:textColor="@color/luxury_cream"
            android:textSize="11sp"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/tvMediaTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <LinearLayout
            android:id="@+id/mediaControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tvSongName">

            <Button
                android:id="@+id/btnPrev"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="⏮"
                android:textColor="@color/luxury_gold"/>

            <Button
                android:id="@+id/btnPlay"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="▶"
                android:textColor="@color/luxury_cream"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnNext"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="⏭"
                android:textColor="@color/luxury_gold"/>
        </LinearLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/luxury_card_stroke"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/mediaControls"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/divider">

            <Button
                android:id="@+id/btnMap"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="نقشه"
                android:textColor="@color/luxury_cream"
                android:textSize="11sp"/>

            <Button
                android:id="@+id/btnSettings"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="تنظیمات"
                android:textColor="@color/luxury_cream"
                android:textSize="11sp"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
