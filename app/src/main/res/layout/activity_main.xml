<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/luxury_black"
    android:padding="10dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ATLAS G SPORT"
            android:textColor="@color/luxury_gold"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="18dp"
            android:text="1405/08/16"
            android:textColor="@color/luxury_gray"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:00"
            android:textColor="@color/luxury_cream"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Weather panel -->
    <LinearLayout
        android:id="@+id/weatherPanel"
        android:layout_width="145dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_luxury_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WEATHER"
            android:textColor="@color/luxury_gold"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="☀"
            android:textColor="@color/luxury_gold"
            android:textSize="38sp" />

        <TextView
            android:id="@+id/tvWeatherTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="--°"
            android:textColor="@color/luxury_cream"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWeatherCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Yazd"
            android:textColor="@color/luxury_cream"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvWeatherCondition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Weather"
            android:textColor="@color/luxury_gray"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Center car panel -->
    <FrameLayout
        android:id="@+id/centerPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_luxury_card"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toEndOf="@id/weatherPanel"
        app:layout_constraintEnd_toStartOf="@id/tirePanel">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:text="SAIPA ATLAS G"
            android:textColor="@color/luxury_gold"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgAtlas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/atlas_car"
            android:contentDescription="Saipa Atlas G" />

    </FrameLayout>

    <!-- Tire pressure panel -->
    <LinearLayout
        android:id="@+id/tirePanel"
        android:layout_width="160dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_luxury_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIRE PRESSURE"
            android:textColor="@color/luxury_gold"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFrontTires"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="FRONT\n--   |   --"
            android:textColor="@color/luxury_cream"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRearTires"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="REAR\n--   |   --"
            android:textColor="@color/luxury_cream"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTpmsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="TPMS"
            android:textColor="@color/luxury_gold"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Bottom control bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="86dp"
        android:background="@drawable/bg_luxury_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0\nkm/h"
            android:textColor="@color/luxury_gold"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMap"
            android:layout_width="55dp"
            android:layout_height="58dp"
            android:backgroundTint="@color/luxury_card_bg"
            android:minWidth="0dp"
            android:text="MAP"
            android:textColor="@color/luxury_cream"
            android:textSize="10sp" />

        <!-- Music controls -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPrev"
                android:layout_width="42dp"
                android:layout_height="52dp"
                android:backgroundTint="@color/luxury_card_bg"
                android:minWidth="0dp"
                android:text="|◀"
                android:textColor="@color/luxury_gold"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tvSongName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="No music playing"
                    android:textColor="@color/luxury_cream"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Media player"
                    android:textColor="@color/luxury_gray"
                    android:textSize="10sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnPlay"
                android:layout_width="48dp"
                android:layout_height="58dp"
                android:backgroundTint="@color/luxury_gold_dark"
                android:minWidth="0dp"
                android:text="▶"
                android:textColor="@color/luxury_black"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="42dp"
                android:layout_height="52dp"
                android:backgroundTint="@color/luxury_card_bg"
                android:minWidth="0dp"
                android:text="▶|"
                android:textColor="@color/luxury_gold"
                android:textSize="13sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnApps"
            android:layout_width="55dp"
            android:layout_height="58dp"
            android:backgroundTint="@color/luxury_card_bg"
            android:minWidth="0dp"
            android:text="APPS"
            android:textColor="@color/luxury_cream"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="55dp"
            android:layout_height="58dp"
            android:backgroundTint="@color/luxury_card_bg"
            android:minWidth="0dp"
            android:text="SET"
            android:textColor="@color/luxury_cream"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnAbout"
            android:layout_width="55dp"
            android:layout_height="58dp"
            android:backgroundTint="@color/luxury_card_bg"
            android:minWidth="0dp"
            android:text="INFO"
            android:textColor="@color/luxury_cream"
            android:textSize="10sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
