<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard"
    android:padding="8dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.12" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.79" />

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_panel_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guidelineHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ATLAS G  /  SPORT"
                android:textColor="@color/luxury_gold"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="DRIVE YOUR STYLE"
                android:textColor="#A6A9B1"
                android:textSize="9sp"
                android:letterSpacing="0.18"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="18dp"
            android:text="● GPS   ◉ Wi-Fi   ᛒ BT"
            android:textColor="@color/luxury_cream"
            android:textSize="11sp"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20:45"
                android:textColor="@color/luxury_cream"
                android:textSize="25sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1405/08/24"
                android:textColor="@color/luxury_gold"
                android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/weatherPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/bg_panel_glass"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintWidth_percent="0.17"
        app:layout_constraintTop_toTopOf="@id/guidelineHeader"
        app:layout_constraintBottom_toTopOf="@id/guidelineBottom"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WEATHER  /  آب‌وهوا"
            android:textColor="@color/luxury_gold"
            android:textSize="10sp"
            android:textStyle="bold"/>
        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/ic_sun"
            android:contentDescription="Weather"/>
        <TextView
            android:id="@+id/tvWeatherTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--°C"
            android:textColor="@color/luxury_cream"
            android:textSize="27sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/tvWeatherCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="یزد"
            android:textColor="@color/luxury_cream"
            android:textSize="14sp"/>
        <TextView
            android:id="@+id/tvWeatherCondition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:text="وضعیت هوا"
            android:textColor="#A7AAB2"
            android:textSize="10sp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="13dp"
            android:background="#665B3B"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="LIVE FORECAST"
            android:textColor="#B5A16B"
            android:textSize="9sp"
            android:letterSpacing="0.12"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/centerPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:background="@drawable/bg_hero_panel"
        app:layout_constraintWidth_percent="0.62"
        app:layout_constraintTop_toTopOf="@id/guidelineHeader"
        app:layout_constraintBottom_toTopOf="@id/guidelineBottom"
        app:layout_constraintStart_toEndOf="@id/weatherPanel"
        app:layout_constraintEnd_toStartOf="@id/tirePanel">

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:background="#B89B51"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="13dp"
            android:text="SAIPA  •  ATLAS G"
            android:textColor="@color/luxury_gold"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:text="URBAN CROSSOVER  /  SPORT EDITION"
            android:textColor="#8F939D"
            android:textSize="9sp"
            android:letterSpacing="0.14"/>
        <ImageView
            android:id="@+id/imgAtlas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:paddingStart="18dp"
            android:paddingTop="35dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp"
            android:scaleType="fitCenter"
            android:src="@drawable/atlas_car"
            android:contentDescription="Saipa Atlas G"/>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/tirePanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="7dp"
        android:background="@drawable/bg_panel_glass"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintWidth_percent="0.17"
        app:layout_constraintTop_toTopOf="@id/guidelineHeader"
        app:layout_constraintBottom_toTopOf="@id/guidelineBottom"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TPMS  /  تایرها"
            android:textColor="@color/luxury_gold"
            android:textSize="11sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="◉"
            android:textColor="@color/luxury_gold"
            android:textSize="30sp"/>
        <TextView
            android:id="@+id/tvFrontTires"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="جلو\n--  |  --"
            android:textColor="@color/luxury_cream"
            android:textSize="14sp"
            android:textStyle="bold"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#554B34"/>
        <TextView
            android:id="@+id/tvRearTires"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="عقب\n--  |  --"
            android:textColor="@color/luxury_cream"
            android:textSize="14sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/tvTpmsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:text="● وضعیت نامشخص"
            android:textColor="@color/luxury_gold"
            android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_dock"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="7dp"
        app:layout_constraintTop_toTopOf="@id/guidelineBottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05"
            android:background="@drawable/bg_control_primary"
            android:gravity="center"
            android:text="◉  0\nkm/h"
            android:textColor="#17140B"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_control_button"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:text="نقشه"
            android:drawableTop="@drawable/ic_map"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:textAllCaps="false"
            android:textColor="@color/luxury_cream"
            android:textSize="13sp"/>

        <LinearLayout
            android:id="@+id/musicWidget"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1.45"
            android:background="@drawable/bg_panel_glass"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">
            <TextView
                android:id="@+id/tvSongName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="موسیقی در حال پخش"
                android:textColor="@color/luxury_cream"
                android:textSize="11sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="♪ موسیقی"
                android:textColor="#A7AAB2"
                android:textSize="9sp"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnPrev"
                    android:layout_width="38dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_control_button"
                    android:backgroundTint="@null"
                    android:minWidth="0dp"
                    android:text="|◀"
                    android:textColor="@color/luxury_gold"
                    android:textSize="11sp"/>
                <Button
                    android:id="@+id/btnPlay"
                    android:layout_width="42dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_control_primary"
                    android:backgroundTint="@null"
                    android:minWidth="0dp"
                    android:text="▶"
                    android:textColor="#17140B"
                    android:textSize="14sp"/>
                <Button
                    android:id="@+id/btnNext"
                    android:layout_width="38dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_control_button"
                    android:backgroundTint="@null"
                    android:minWidth="0dp"
                    android:text="▶|"
                    android:textColor="@color/luxury_gold"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnApps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_control_button"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:text="برنامه‌ها"
            android:drawableTop="@drawable/ic_apps"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:textAllCaps="false"
            android:textColor="@color/luxury_cream"
            android:textSize="12sp"/>
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_control_button"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:text="تنظیمات"
            android:drawableTop="@drawable/ic_settings"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:textAllCaps="false"
            android:textColor="@color/luxury_cream"
            android:textSize="12sp"/>
        <Button
            android:id="@+id/btnAbout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_control_button"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:text="درباره ما"
            android:drawableTop="@drawable/ic_info"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:textAllCaps="false"
            android:textColor="@color/luxury_cream"
            android:textSize="12sp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
